{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "data/trip.json 的格式規格。tools/check-trip.mjs 會用這份檔案檢查；VS Code 也會用它提供自動完成和錯誤提示。",
  "title": "旅行繪本行程資料",
  "type": "object",
  "required": ["id", "title", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "給編輯器用的格式規格位置，頁面不會讀取"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "patternErrorMessage": "只能用英文、數字、底線和連字號，例如 fukuoka 或 kyoto-2026",
      "description": "這趟旅程的代號。「去過」的蓋章紀錄依這個代號分開存，換旅程時要改"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "封面標題，也是瀏覽器分頁標題"
    },
    "subtitle": {
      "type": "string",
      "description": "封面副標，後面會自動接「共 N 個地點」"
    },
    "startDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "patternErrorMessage": "日期格式是 YYYY-MM-DD，例如 2026-11-21",
      "description": "第 1 天的日期。首頁會依日期顯示那一天的天氣預報，旅行期間打開會自動跳到今天"
    },
    "timeNote": {
      "type": "string",
      "description": "行程時間的說明，顯示在行程清單和首頁當日行程上方，例如「時間都是日本時間，比台灣快 1 小時」"
    },
    "weather": {
      "type": "object",
      "description": "首頁天氣看板的設定",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string",
          "description": "旅遊地的時區，例如 Asia/Tokyo，用來決定天氣預報的「今天」"
        },
        "default": {
          "$ref": "#/definitions/place",
          "description": "days 沒有寫 weather 的天數，用這個地點的天氣"
        },
        "climate": {
          "type": "object",
          "description": "旅遊季節的往年平均氣候。還沒有預報或讀不到天氣時，用文字顯示「往年這時候大約…」",
          "additionalProperties": false,
          "properties": {
            "max": { "type": "number", "description": "最高溫 °C" },
            "min": { "type": "number", "description": "最低溫 °C" },
            "rain": { "type": "number", "minimum": 0, "maximum": 100, "description": "降雨機率 %" }
          }
        }
      }
    },
    "_說明": {
      "type": "string",
      "description": "給編輯的人看的備註，頁面不會讀取"
    },
    "days": {
      "type": "array",
      "description": "每天的標題。沒寫到的天數只會顯示 Day N",
      "items": {
        "type": "object",
        "required": ["day", "name"],
        "additionalProperties": false,
        "properties": {
          "day": { "type": "integer", "minimum": 1, "description": "第幾天，從 1 開始" },
          "name": { "type": "string", "description": "這一天的標題，例如「天神」" },
          "weather": { "$ref": "#/definitions/place", "description": "這一天看哪裡的天氣；沒寫就用最外層 weather.default" }
        }
      }
    },
    "items": {
      "type": "array",
      "description": "所有地點。順序不重要，頁面會依天數和時間排序",
      "items": { "$ref": "#/definitions/item" }
    }
  },
  "definitions": {
    "place": {
      "type": "object",
      "required": ["name", "lat", "lng"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "天氣看板上顯示的地名" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90, "description": "緯度" },
        "lng": { "type": "number", "minimum": -180, "maximum": 180, "description": "經度" }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "day", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "地點代號，不可重複。蓋章紀錄靠它對應，已經有人蓋過章的地點不要改 id"
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "description": "第幾天"
        },
        "time": {
          "type": "string",
          "pattern": "^(|([01][0-9]|2[0-3]):[0-5][0-9])$",
          "patternErrorMessage": "時間格式是 HH:MM，例如 09:30；不確定可以留空",
          "description": "預計時間，同一天依這個排序；留空會排在最後並顯示「未定」"
        },
        "tz": {
          "type": "string",
          "description": "time 不是當地時間時填，例如從台灣起飛的班機填「台灣時間」，會標在時間下方；當地時間不用填"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "地點名稱"
        },
        "ja": {
          "type": "string",
          "description": "日文名稱。指指卡給司機、路人看的時候用；住宿一定要填"
        },
        "address": {
          "type": "string",
          "description": "日文地址。指指卡的「帶我回飯店」會用大字顯示；住宿一定要填"
        },
        "category": {
          "type": "string",
          "enum": ["景點", "美食", "購物", "交通", "住宿", ""],
          "description": "分類，決定圖示、顏色和卡片樣式。點心、咖啡也歸在「美食」；留空會當成景點"
        },
        "gmap": {
          "type": "string",
          "pattern": "^(|https?://.+)$",
          "patternErrorMessage": "要是 http:// 或 https:// 開頭的網址，或留空",
          "description": "Google 地圖連結。留空時導航會改用經緯度"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "緯度。和 lng 都有填才會出現在地圖上"
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "經度"
        },
        "desc": {
          "type": "string",
          "description": "描述。「營業時間:」和「最早可訂位時間：」後面的文字會自動拆成獨立一行"
        },
        "price": {
          "type": "string",
          "description": "價位，例如 ¥2,000-3,000；可留空"
        }
      }
    }
  }
}
